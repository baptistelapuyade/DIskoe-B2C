# Public Supabase API URL for the selected local, preview, or production project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Public/publishable Supabase key. Never put a service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Fallback origin for auth redirects when the request carries no usable host
# (normally the origin is taken from the request). Add every origin you sign in
# from to the Supabase "Redirect URLs" allow-list.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Optional Sentry DSNs. Monitoring remains inactive when these are empty.
# Both DSNs must belong to a Sentry EU-region project (*.de.sentry.io).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Non-sensitive environment labels used to separate local, preview, and production errors.
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Build-only Sentry credentials for a future source-map upload. Leave empty locally.
# They are server/build secrets and must never use the NEXT_PUBLIC prefix.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# System mails (profile approved, question about a profile) over SMTP, server
# side only. Real values go into the hosting environment or .env.local, never
# into Git. Without them no mail is sent and the founder page says so.
# Amazon SES: host email-smtp.eu-central-1.amazonaws.com, port 587, SMTP
# credentials of an IAM user that may only send (ses:SendRawEmail). The sender
# must be a verified SES identity.
# Local/CI: the mail catcher of the Supabase stack (127.0.0.1:54325), no login.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM=
